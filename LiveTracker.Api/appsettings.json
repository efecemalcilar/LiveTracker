{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=livetracker;Username=livetracker;Password=dev_password_only"
  },
  "Ingestion": {
    "FeedUrl": "https://api.entur.io/realtime/v1/gtfs-rt/vehicle-positions",
    "PollIntervalSeconds": 3,
    "RequestTimeoutSeconds": 10,
    "ClientName": "efe-livetracker-case"
  },
  "Retention": {
    "Window": "03:00:00",
    "ChunkInterval": "00:15:00",
    "CleanupInterval": "00:01:00"
  }
}